---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
---
<article class="pcard">
  <div class="shot" aria-hidden="true">
    {/* Both themes are captured by scripts/demos/screenshots.ts; CSS shows the one matching the page. */}
    <img class="dark" src={`/images/shots/${project.id}-dark.png`} alt="" width="1280" height="800" loading="lazy" decoding="async" />
    <img class="light" src={`/images/shots/${project.id}-light.png`} alt="" width="1280" height="800" loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <h3><a href={`/projects/${project.id}/`}>{p.title}</a>{p.subtitle && <span class="jp" lang="ja"> {p.subtitle}</span>}</h3>
    <p class="sub">{p.tagline}</p>
    <p class="stack">{p.stack.slice(0, 6).join(', ')}</p>
  </div>
</article>
<style>
  .pcard { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m); overflow: hidden; }
  .pcard:hover, .pcard:focus-within { border-color: var(--line-strong); }
  .shot { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--raised); }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .shot .light { display: none; }
  :global([data-theme="light"]) .shot .dark { display: none; }
  :global([data-theme="light"]) .shot .light { display: block; }
  .body { padding: 1.1rem 1.2rem 1.3rem; display: grid; gap: .5rem; }
  h3 { margin: 0; font-size: var(--step-2); }
  h3 a { text-decoration: none; }
  /* The whole card is the target; the title link stretches over it. */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .pcard { position: relative; }
  .pcard:hover h3 a { text-decoration: underline; text-decoration-color: var(--signal); }
  .jp { font-weight: 400; color: var(--muted); font-size: .95rem; }
  p { margin: 0; }
</style>

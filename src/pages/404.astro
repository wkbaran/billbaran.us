---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <span class="eyebrow">404</span>
    <h1>Nothing here.</h1>
    <p class="lede">That page doesn't exist, or it moved.</p>
    <a class="btn btn-signal" href="/">Back to the start</a>
  </section>
</Base>
<style>.nf { padding: 7rem var(--gutter) 6rem; }</style>

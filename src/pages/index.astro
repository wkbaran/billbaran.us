---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import RunDiagram from '../components/RunDiagram.astro';
import { SITE } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const alsoBuilt = await getCollection('alsoBuilt');
const jobs = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({ ...e.data, Content: (await render(e)).Content })),
);
const dev = import.meta.env.DEV;

const hobbies = [
  {
    title: 'Self-hosting',
    body: 'A home server runs my Docker stack: every app on this site, the scheduled jobs that publish them, an agent harness, and a local GPU model that handles most of the LLM work for free. If a SaaS has a monthly fee and an API, I have probably thought about replacing it.',
  },
  {
    title: '3D printing',
    body: 'Functional parts, designed myself. I learned Fusion 360 to model them, most recently a set of brackets for LED lighting. Measure, model, print, then reprint once more.',
  },
  {
    title: 'Learning Japanese',
    body: 'Slowly, through real news. Kotoba no Sekai began as my own study tool: a few new words a day, at my level, each with the sentence it came from.',
    link: { href: '/projects/kotoba/', label: 'Kotoba no Sekai' },
  },
  {
    title: 'Options and markets',
    body: 'I trade credit spreads and track a long-term portfolio, so I build my own tools for it: alerts that suggest what to do next, risk heatmaps, and a look at what Congress is trading.',
    link: { href: '/projects/spread-book/', label: 'Spread Book' },
  },
];
---
<Base current="home">
  <section class="hero">
    <div class="wrap">
      <h1 class="name">Bill Baran</h1>
      <p class="role">Software architect in {SITE.location}, {SITE.years} years in.</p>
      <p class="lede">
        {SITE.summary}{' '}
        Below are four apps I run every day, each with a working demo. There's also <a href="/llm-workflows/">how I build with LLMs</a>, and you can <a href="#contact">email me</a>.
      </p>
    </div>
  </section>

  <section class="block first" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-h">Things I run every day</h2>
        <p class="sub note">
          These are self-hosted apps I use daily. Each demo runs the app's own page code on invented data, because the live data comes from services licensed for personal use.
        </p>
      </div>
      <div class="grid projects">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>

      <div class="llm-teaser">
        <div>
          <h3><a href="/llm-workflows/">Scheduled agents that are cheap and don't make mistakes</a></h3>
          <p class="sub">
            Three MCP servers I wrote, for Substack, Medium and Spotify, plus the Hermes skills and cron jobs that use them. They produce a daily reading digest and a playlist twice a week.
            Moving the bookkeeping out of the prompt and into code cut the Medium digest from <strong>$3.26 to $0.27</strong> a run.
            The Substack digest and the playlist now run entirely on a local model.
          </p>
          <a class="go" href="/llm-workflows/#replay">Step through a real run</a>
        </div>
        <RunDiagram kind="digest" title="One digest run, split between the model and the server" caption="The model acts at steps 2, 3, 4 and 6. Everything in the server lane is code." />
      </div>
    </div>
  </section>

  <section class="block" id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <h2 id="skills-h">Skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.data.group}</dt>
            <dd>{s.data.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="block" id="experience" aria-labelledby="experience-h">
    <div class="wrap">
      <h2 id="experience-h">Experience</h2>
      <ol class="timeline">
        {jobs.map((j) => (
          <li class:list={['job', { draft: dev && j.draft }]}>
            <div class="when">{j.start}–{j.end ?? 'now'}</div>
            <div>
              <h3>{j.role}, <span class="org">{j.org}</span></h3>
              {j.location && <p class="muted loc">{j.location}</p>}
              <div class="prose sub"><j.Content /></div>
            </div>
          </li>
        ))}
        <li class="job">
          <div class="when">Education</div>
          <div>
            <h3>BS Computer Science, <span class="org">Rose-Hulman Institute of Technology</span></h3>
            <p class="muted loc">Minor in mathematics</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="block" id="also" aria-labelledby="also-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="also-h">Smaller tools</h2>
        <a href={SITE.github} target="_blank" rel="noopener">Everything else on GitHub ↗</a>
      </div>
      <ul class="also">
        {alsoBuilt.map((r) => (
          <li>
            <a href={r.data.repo} target="_blank" rel="noopener">{r.data.name} ↗</a>
            <span class="sub">{r.data.blurb}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block" id="hobbies" aria-labelledby="hobbies-h">
    <div class="wrap">
      <h2 id="hobbies-h">Off the clock</h2>
      <div class="hobbies">
        {hobbies.map((h) => (
          <div>
            <h3>{h.title}</h3>
            <p class="sub">
              {h.body}
              {h.link && <> <a href={h.link.href}>See {h.link.label}.</a></>}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <h2 id="contact-h">Contact</h2>
      <p class="lede">I take on occasional consulting and contract work: architecture, moving systems to AWS, retiring legacy platforms, and bringing AI-assisted development to a team. If that's you, or you're curious how something here works, email is the best way to reach me.</p>
      <Contact />
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(3.5rem, 10vw, 7rem) 0 clamp(2rem, 5vw, 3.5rem); }
  /* The one loud element: the name set at Archivo's widest. */
  .name {
    font-size: clamp(3rem, 14.5vw, 7.5rem); font-weight: 850; font-stretch: 125%;
    letter-spacing: -0.035em; line-height: .92; margin: 0 0 1.4rem;
  }
  .role { font-size: var(--step-2); font-weight: 600; font-stretch: 90%; margin: 0 0 .8rem; }
  .lede a { color: var(--ink); text-decoration-color: var(--signal); }

  .block.first { border-top: 0; padding-top: 0; }
  .note { margin: 0; max-width: 52ch; font-size: var(--step--1); }
  .projects { grid-template-columns: repeat(auto-fill, minmax(min(100%, 31rem), 1fr)); }

  .llm-teaser { margin-top: 1.2rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 2rem; align-items: center;
    border-top: 1px solid var(--line); padding-top: 2rem; }
  .llm-teaser h3 { font-size: var(--step-3); font-stretch: 85%; font-weight: 650; }
  .llm-teaser h3 a { text-decoration: none; }
  .llm-teaser h3 a:hover { text-decoration: underline; text-decoration-color: var(--signal); }
  .llm-teaser .go { font-weight: 650; text-decoration-color: var(--signal); }
  @media (max-width: 860px) { .llm-teaser { grid-template-columns: 1fr; } }

  .skills { margin: 0; display: grid; }
  .skills > div { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 1.5rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .skills > div:first-child { border-top: 1px solid var(--line); }
  .skills dt { font-weight: 650; }
  .skills dd { margin: 0; color: var(--sub); max-width: 70ch; }
  @media (max-width: 620px) { .skills > div { grid-template-columns: 1fr; gap: .2rem; } }

  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 2.2rem; }
  .job { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.2rem; }
  .job h3 { margin-bottom: .2rem; }
  .job.draft { outline: 1px dashed var(--signal); outline-offset: 8px; }
  .job.draft::before { content: 'Draft: waiting on the career interview'; position: absolute; transform: translateY(-1.6rem); font-size: .7rem; color: var(--signal); }
  .when { font-stretch: 85%; font-weight: 650; color: var(--sub); padding-top: .1rem; font-variant-numeric: tabular-nums; }
  .org { font-weight: 400; color: var(--sub); }
  .loc { margin: 0 0 .6rem; font-size: var(--step--1); }
  .job :global(ul) { padding-left: 1.1rem; margin: .4rem 0 0; }
  .job :global(li) { margin-bottom: .4rem; }
  @media (max-width: 620px) { .job { grid-template-columns: 1fr; gap: .3rem; } }

  .also { list-style: none; padding: 0; margin: 0; }
  .also li { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 1.5rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .also li:first-child { border-top: 1px solid var(--line); }
  .also a { font-weight: 650; text-decoration: none; }
  .also a:hover { text-decoration: underline; text-decoration-color: var(--signal); }
  @media (max-width: 620px) { .also li { grid-template-columns: 1fr; gap: .2rem; } }

  .hobbies { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 1.8rem 3rem; }
  .hobbies h3 { font-size: var(--step-1); margin-bottom: .4rem; }
  .hobbies p { margin: 0; max-width: 60ch; }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <h1>Page not found</h1>
    <p class="lede">There's no page at this address. It may have moved.</p>
    <a class="btn btn-signal" href="/">Go to the home page</a>
  </section>
</Base>
<style>.nf { padding: 7rem var(--gutter) 6rem; }</style>

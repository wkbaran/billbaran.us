---
/**
 * An inline term with a definition shown on hover, keyboard focus or tap.
 * The visible tooltip is positioned against the viewport, so a scrolling
 * container (like .table-scroll) can't clip it; screen readers get the
 * definition through aria-describedby instead.
 */
interface Props { tip: string }
const { tip } = Astro.props;
const id = `term-${Math.random().toString(36).slice(2, 8)}`;
---
<span class="term" tabindex="0" data-tip={tip} aria-describedby={id}><slot /><span id={id} class="sr-only">{tip}</span></span>

<script>
  let tipEl: HTMLDivElement | null = null;
  let current: HTMLElement | null = null;

  function bubble() {
    if (!tipEl) {
      tipEl = document.createElement('div');
      tipEl.className = 'term-tip';
      tipEl.setAttribute('aria-hidden', 'true');
      document.body.append(tipEl);
    }
    return tipEl;
  }

  function show(el: HTMLElement) {
    const tip = bubble();
    current = el;
    tip.textContent = el.dataset.tip ?? '';
    tip.hidden = false;
    const r = el.getBoundingClientRect();
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    const left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), innerWidth - w - 8);
    const above = r.top - h - 8;
    tip.style.left = `${left}px`;
    tip.style.top = `${above > 8 ? above : r.bottom + 8}px`;
  }

  function hide(el?: HTMLElement) {
    if (el && el !== current) return;
    if (tipEl) tipEl.hidden = true;
    current = null;
  }

  for (const el of document.querySelectorAll<HTMLElement>('.term')) {
    el.addEventListener('mouseenter', () => show(el));
    el.addEventListener('mouseleave', () => { if (document.activeElement !== el) hide(el); });
    el.addEventListener('focus', () => show(el));
    el.addEventListener('blur', () => hide(el));
    el.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(el); });
  }
  addEventListener('scroll', () => hide(), { passive: true });
  addEventListener('resize', () => hide());
</script>

<style>
  .term { text-decoration: underline dotted; text-decoration-color: var(--muted); text-underline-offset: 3px; cursor: help; }
  .term:hover, .term:focus-visible { text-decoration-color: var(--signal); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :global(.term-tip) {
    position: fixed; z-index: 60; max-width: min(22rem, calc(100vw - 16px)); padding: .6rem .75rem;
    background: var(--raised); color: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius-s);
    box-shadow: var(--shadow); font-size: var(--step--1); line-height: 1.45; font-weight: 400; pointer-events: none;
  }
  :global(.term-tip[hidden]) { display: none; }
</style>

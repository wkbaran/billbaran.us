---
import Base from '../layouts/Base.astro';
import Replay from '../components/Replay.astro';
import RunDiagram from '../components/RunDiagram.astro';
import replays from '../data/replays.json';

const servers = [
  {
    name: 'substack-reader-mcp',
    repo: 'https://github.com/wkbaran/substack-reader-mcp',
    what: 'Reads my Substack subscriptions, posts, chats and DMs, and runs the daily digest.',
    tools: ['get_feed', 'read_post', 'search_posts', 'list_chats', 'read_chat_thread', 'interests_evidence', 'digest_begin', 'digest_finish'],
    notes: [
      'Handles rate limits: fetches 3 publications at a time, backs off 2/5/10 s with jitter, and retries the ones that failed one at a time. A publication that keeps failing is retried next run.',
      "Detects paywalls from the paywall-jump marker, because a truncated post still comes back as HTTP 200.",
      'Gets a session on custom domains by reproducing the browser sign-in handoff. Never calls the endpoints that mark things as seen.',
    ],
  },
  {
    name: 'medium-reader-mcp',
    repo: 'https://github.com/wkbaran/medium-reader-mcp',
    what: 'Reads Medium Following and For-you feeds, including full member-only posts, with optional follows, lists and claps.',
    tools: ['get_feed', 'read_post', 'rate_headings', 'list_reading_lists', 'interests_evidence', 'digest_begin', 'digest_finish'],
    notes: [
      'Mapped all 975 positions of For you. The top 25 are site-wide picks and positions 25–250 are personal. It never pages past 250, because doing that rebuilds your homepage.',
      'rate_headings uses MCP sampling to have the client\'s own model rate headlines.',
      'Jev headline ranking costs about a cent a day. Against 160 hand-labelled headlines, 10 of its top 10 were posts I wanted; a local 27B model got 7.',
    ],
  },
  {
    name: 'spotify-discovery-mcp',
    repo: 'https://github.com/wkbaran/spotify-discovery-mcp',
    what: 'Runs a discovery playlist for a scheduled agent. The code handles feeds, verification, dedup and state. The model only judges the music.',
    tools: ['discovery_begin', 'verify_tracks', 'discovery_review', 'discovery_finish', 'discovery_status', 'forget'],
    notes: [
      'Checks web finds with exact field searches, then compares the label on the ℗ line with what the source claimed.',
      'Dedups by URI, by ISRC, and by a normalized artist + title key, which catches Spotify relinking.',
      'Enforces pick limits by dropping from the end rather than refusing the call. Lanes learn which labels keep producing.',
    ],
  },
];

const rules = [
  ['Measure where the money goes', 'In v1, the orchestrator\'s bookkeeping cost 5× as much as the subagents doing the reading.'],
  ['Give the model refs, not data', 'Anything the model copies, it can corrupt. Once a digest went out with 10 of 12 summaries on the wrong posts.'],
  ['Save state inside the final tool call', 'A cron run ends at the last message, so a "then update state" step never ran.'],
  ['Fix reliability with tools, not instructions', 'Each new tool took a decision away from the model, and each of those decisions had failed before.'],
  ['Label your own data before tuning', 'Ten minutes of hand labels showed that my written interest profile was wrong, not the classifier.'],
];
---
<Base title="LLM workflows" description="MCP servers and scheduled agent jobs where the model only judges and code does the bookkeeping." current="llm">
  <section class="intro">
    <div class="wrap">
      <h1>The model judges.<br />The server does everything else.</h1>
      <p class="lede">
        Every morning, scheduled agents post a reading digest of Substack and Medium to my Discord. Twice a week they build a Spotify playlist of new music.
        They run on <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener">Hermes Agent</a> on a home server, using three MCP servers I wrote.
        The first versions were long prompts that did everything. The current ones give the model only judgment calls and handle everything else in code.
      </p>
      <div class="stats">
        <div><strong>$3.26 → $0.27</strong><span>Medium digest, per run</span></div>
        <div><strong>25 → 8 min</strong><span>Medium digest, wall time</span></div>
        <div><strong>$0.00</strong><span>Substack digest &amp; Spotify lanes, on a local Qwen 27B</span></div>
        <div><strong>By ref</strong><span>the server resolves every ref, so a summary can't land on the wrong post</span></div>
      </div>
    </div>
  </section>

  <section class="block flow">
    <div class="wrap">
      <h2>From feed to Discord</h2>
      <figure class="arch" aria-label="Sources feed MCP servers, which Hermes cron jobs drive; models judge, and results go to Discord and Spotify.">
        <div class="col">
          <h3>Sources</h3>
          <div class="node">Substack</div><div class="node">Medium</div><div class="node">Spotify + open web</div>
        </div>
        <div class="arrow" aria-hidden="true">→</div>
        <div class="col server">
          <h3>MCP servers <small>code</small></h3>
          <div class="node">substack-reader-mcp</div><div class="node">medium-reader-mcp</div><div class="node">spotify-discovery-mcp</div>
          <div class="node lib">job-ledger: state, locks, refs, dedup</div>
        </div>
        <div class="arrow" aria-hidden="true">⇄</div>
        <div class="col model">
          <h3>Hermes Agent <small>models</small></h3>
          <div class="node">cron → skill</div>
          <div class="node">main model: Sonnet or local Qwen</div>
          <div class="node">subagents: local Qwen 27B</div>
          <div class="node">Jev headline ranking (~1¢/day)</div>
        </div>
        <div class="arrow" aria-hidden="true">→</div>
        <div class="col">
          <h3>Output</h3>
          <div class="node">Discord digests</div><div class="node">Private playlist <code>hermesYYYYMMDD</code></div><div class="node">No-model report job</div>
        </div>
      </figure>
    </div>
  </section>

  <section class="block" id="replay">
    <div class="wrap">
      <h2>What the model sees, and what the server does</h2>
      <p class="sub prose">
        These are the worked examples from each server's docs, with fictional posts and tracks. A test checks them against real tool output, so every call and every result below is exactly what the tools produce.
      </p>
      <Replay replays={replays} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Three MCP servers, one design</h2>
      <div class="grid servers">
        {servers.map((s) => (
          <article class="card">
            <h3><a href={s.repo} target="_blank" rel="noopener">{s.name} ↗</a></h3>
            <p class="sub">{s.what}</p>
            <p class="tools">{s.tools.map((t, i) => <>{i > 0 && ' '}<code>{t}</code></>)}</p>
            <ul class="notes">{s.notes.map((n) => <li>{n}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="muted small">
        TypeScript on the official MCP SDK, with zod schemas and vitest. All three are MIT-licensed. The reader servers use each site's own web API with my session, read-only by default.
        State writes take a lock, go through a temp file and a rename, and keep a <code>.bak</code>, because Hermes runs two copies of each server at once.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap two">
      <div>
        <h2>Ten days of Medium runs</h2>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Run</th><th>Design</th><th class="num">Cost</th><th class="num">Time</th></tr></thead>
            <tbody>
              <tr><td>Sep 29</td><td>One big prompt, Sonnet everywhere</td><td class="num">$3.26</td><td class="num">25 min</td></tr>
              <tr><td>Oct 2</td><td>Local subagents, same prompt</td><td class="num">$1.53</td><td class="num">19 min</td></tr>
              <tr><td>Oct 3</td><td>Digest tools: refs + server-side state</td><td class="num">$0.42</td><td class="num">13 min</td></tr>
              <tr class="hl"><td>Oct 4</td><td>+ Jev headline ranking</td><td class="num">$0.27</td><td class="num">8 min</td></tr>
            </tbody>
          </table>
        </div>
        <h3 class="mt">Headline ranking benchmark <span class="muted">(160 hand-labelled headlines)</span></h3>
        <div class="table-scroll">
          <table>
            <thead><tr><th></th><th class="num">Jev</th><th class="num">Local Qwen 27B</th></tr></thead>
            <tbody>
              <tr><td>AUC</td><td class="num">76</td><td class="num">75</td></tr>
              <tr><td>NDCG@20</td><td class="num"><strong>72</strong></td><td class="num">63</td></tr>
              <tr><td>Wanted posts in top 10</td><td class="num"><strong>10/10</strong></td><td class="num">7/10</td></tr>
              <tr><td>Time for 160 headlines</td><td class="num"><strong>3 s</strong></td><td class="num">178 s</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <h2>What I'd pass on</h2>
        <ol class="rules">
          {rules.map(([t, d]) => <li><strong>{t}.</strong> <span class="sub">{d}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2>Who acts at each step</h2>
      <div class="diagrams">
        <RunDiagram kind="digest" title="One digest run, split between the model and the server" caption="A digest run. The model acts at steps 2, 3, 4 and 6." />
        <RunDiagram kind="spotify" title="One Spotify lane run, split between the models and the server" caption="A Spotify lane. Delivery is a separate job with no model." />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding: clamp(2.5rem, 8vw, 5rem) 0 3rem; }
  .intro h1 { font-size: clamp(2.1rem, 5.4vw, 3.8rem); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin-top: 2.2rem; }
  .stats div { border-top: 1px solid var(--line-strong); padding-top: .7rem; }
  .stats strong { display: block; font-size: var(--step-3); font-stretch: 85%; }
  .stats span { color: var(--sub); font-size: .9rem; }

  .arch { margin: 1.5rem 0 0; display: grid; grid-template-columns: 1fr auto 1.2fr auto 1.2fr auto 1fr; gap: .8rem; align-items: center; }
  .arch .col { display: grid; gap: .5rem; align-content: start; }
  .arch h3 { font-size: var(--step-0); color: var(--ink); margin: 0 0 .2rem; }
  .arch small { color: var(--muted); font-weight: 400; }
  .node { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-s); padding: .5rem .7rem; font-size: .88rem; }
  .server .node { border-color: color-mix(in oklab, #3c9a73 55%, var(--line)); }
  .model .node { border-color: color-mix(in oklab, var(--signal) 55%, var(--line)); }
  .node.lib { border-style: dashed; color: var(--sub); }
  .arrow { color: var(--signal); font-size: 1.4rem; }
  @media (max-width: 900px) { .arch { grid-template-columns: 1fr; } .arrow { transform: rotate(90deg); justify-self: center; } }

  .servers { grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); margin-bottom: 1.2rem; }
  .servers h3 a { text-decoration: none; font-family: ui-monospace, Menlo, monospace; font-size: 1rem; }
  .tools { margin: .2rem 0 1rem; line-height: 2; }
  .tools code { font-size: .75rem; }
  .notes { padding-left: 1.1rem; margin: 0; font-size: .9rem; color: var(--sub); }
  .notes li { margin-bottom: .5rem; }
  .notes li::marker { color: var(--signal); }
  .small { font-size: .88rem; max-width: 80ch; }

  .two { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
  .table-scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .92rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; font-size: var(--step--1); }
  .num { text-align: right; white-space: nowrap; }
  tr.hl td { background: var(--wash); font-weight: 650; }
  .mt { margin-top: 2rem; font-size: 1rem; }
  .rules { padding-left: 1.3rem; display: grid; gap: .9rem; }
  .rules li::marker { color: var(--signal); font-weight: 700; }

  .diagrams { display: grid; gap: 1.5rem; }
</style>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> }
const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const demoSrc = p.demo ? `/demos/${p.demo}/${p.demoPage}` : null;
---
<Base title={p.title} description={p.tagline} current="projects">
  <section class="intro">
    <div class="wrap">
      <a class="back" href="/#projects">All projects</a>
      <h1>{p.title}{p.subtitle && <span class="jp" lang="ja">{p.subtitle}</span>}</h1>
      <p class="lede">{p.tagline}</p>
      <p class="links">
        <a href={p.repo} target="_blank" rel="noopener">Source on GitHub ↗</a>
        {p.live && <span class="muted">Runs daily at {new URL(p.live).host}, on my own data</span>}
      </p>
    </div>
  </section>

  {demoSrc && (
    <section class="demo" id="demo" aria-label={`${p.title} demo`}>
      <div class="wrap">
        <div class="frame">
          <div class="bar">
            <span>Demo with invented data</span>
            <a href={demoSrc} target="_blank" rel="noopener">Open full screen ↗</a>
          </div>
          <iframe src={demoSrc} title={`${p.title} demo`}></iframe>
        </div>
        <p class="muted demo-note">{p.demoNote} Nothing in the demo contacts a market-data, news or brokerage service.</p>
      </div>
    </section>
  )}

  <section class="detail">
    <div class="wrap cols">
      <div class="prose">
        <Content />
        <h2 class="h3">What's interesting about it</h2>
        <ul class="highlights">{p.highlights.map((h) => <li>{h}</li>)}</ul>
      </div>
      <aside class="side">
        <h2 class="h3">Built with</h2>
        <p class="sub">{p.stack.join(', ')}</p>
        {p.license && <p class="muted small">License: {p.license}</p>}
      </aside>
    </div>
  </section>

  <nav class="next" aria-label="Next project">
    <div class="wrap">
      <span class="muted">Next project</span>
      <a href={`/projects/${next.id}/`}>{next.data.title}</a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding: clamp(2rem, 6vw, 4rem) 0 1.8rem; }
  .back { display: inline-block; margin-bottom: 1.4rem; color: var(--sub); font-size: var(--step--1); }
  .intro h1 { margin-bottom: .6rem; }
  .jp { font-size: .42em; font-weight: 400; font-stretch: 100%; letter-spacing: 0; color: var(--muted); margin-left: .7rem; vertical-align: middle; }
  .links { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; margin: 1rem 0 0; font-size: var(--step--1); }
  .links a { font-weight: 600; text-decoration-color: var(--signal); }

  .frame { border: 1px solid var(--line-strong); border-radius: var(--radius-m); overflow: hidden; background: var(--raised); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .5rem .9rem; border-bottom: 1px solid var(--line); font-size: var(--step--1); color: var(--muted); }
  .bar a { color: var(--ink); font-weight: 600; text-decoration-color: var(--signal); }
  iframe { display: block; width: 100%; height: min(80vh, 900px); border: 0; background: var(--ground); }
  @media (max-width: 620px) { iframe { height: 75vh; } }
  .demo-note { font-size: var(--step--1); margin: .8rem 0 0; max-width: 80ch; }

  .detail { padding: 3rem 0; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 3rem; align-items: start; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 1rem; } }
  .h3 { font-size: var(--step-1); font-weight: 650; font-stretch: 100%; margin: 2rem 0 .7rem; }
  .side { border-left: 1px solid var(--line); padding-left: 1.5rem; }
  .side .h3 { margin-top: .3rem; }
  @media (max-width: 900px) { .side { border-left: 0; padding-left: 0; } }
  .small { font-size: var(--step--1); margin: 1rem 0 0; }
  .highlights { padding-left: 1.1rem; }
  .highlights li { margin-bottom: .6rem; color: var(--sub); }
  .highlights li::marker { color: var(--signal); }

  .next { padding: 2.2rem 0 1rem; border-top: 1px solid var(--line); }
  .next .wrap { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; }
  .next a { font-size: var(--step-3); font-weight: 650; font-stretch: 85%; text-decoration-color: var(--signal); }
</style>
